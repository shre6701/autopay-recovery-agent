# Copy to .env. Don't commit .env.
# Left empty, everything runs in mock mode with no keys and no cost.

# Backend
# Public HTTPS URL Sarvam can reach (ngrok or Render). Used for tool URLs, the webhook and mock pay links.
PUBLIC_BASE_URL=http://localhost:8000
# Long random string. Sarvam sends it as a Bearer token to /tools/* and as ?token= on the webhook.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOOL_SECRET=

# The only number that gets dialled, E.164 format (+91...). Use a phone you own.
DEMO_PHONE_NUMBER=

# Calling policy
CALL_TIMEZONE=Asia/Kolkata
CALL_WINDOW_START=09:00
CALL_WINDOW_END=19:00
MAX_CALL_ATTEMPTS_7D=3
MIN_HOURS_BETWEEN_CALLS=4
MAX_SILENT_RETRIES=2
GRACE_PERIOD_DAYS=7

# Cost per minute, used by the dashboard
AGENT_COST_PER_MIN_INR=3.50
# Telephony is billed separately by Sarvam. Check the rate in your dashboard.
TELEPHONY_COST_PER_MIN_INR=0

# Razorpay test keys (rzp_test_...). Empty = mock links. Live keys are refused.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you add a webhook in the Razorpay dashboard (event: payment_link.paid)
RAZORPAY_WEBHOOK_SECRET=
# true = ask Razorpay to SMS the link to DEMO_PHONE_NUMBER
RAZORPAY_NOTIFY_SMS=false

# Sarvam Voice Agents
# Settings -> API Key in the Voice Agents dashboard (apps.sarvam.ai)
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# The agent's App ID and the committed version number to call
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
# Deploy -> Phone Numbers: the connection ID and the agent's phone number (E.164)
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
